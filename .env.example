# Demo Mode Flag
# true  = enables local demo shortcuts, pre-filled credentials and sample data (LOCAL ONLY)
# false = production secure defaults
#
# WARNING: demo mode MUST be false for every production build. `npm run build`
# enforces this (scripts/check-prod-build.mjs) and fails the build when this is
# "true". Use `npm run build:demo` for an intentional, non-deployable demo build.
VITE_DEMO_MODE=false

# ── AI Assistant (server-side secret — NEVER a VITE_* variable) ──────────────
# There is no client-side AI key. Every VITE_*-prefixed value is inlined into the
# shipped JavaScript bundle and is readable by anyone who loads the site, which
# is how an OpenRouter key previously ended up in dist/assets/*.js.
# Do NOT add VITE_OPENROUTER_API_KEY (or any other VITE_* secret) here.
#
# The key lives only in the Supabase Edge Function secret store and is read at
# runtime via `Deno.env.get('OPENROUTER_API_KEY')`.
#
# Required deployment step (run locally, never commit the value):
#   supabase functions deploy ai-assistant
#   supabase secrets set OPENROUTER_API_KEY=<paste-key-here>
#
# The optional model id below is not a secret (it is sent to the Edge Function).
VITE_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase Dashboard -> Project Settings -> API -> Project URL / anon public key
# Then run supabase/schema.sql and supabase/seed.sql in the SQL Editor.
# The anon key is public by design (RLS is the security boundary). NEVER put the
# service_role key in a VITE_* variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
