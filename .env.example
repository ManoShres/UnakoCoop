# Demo Mode Flag (true: enables local demo shortcuts & pre-fills; false: production secure defaults)
VITE_DEMO_MODE=false

# OpenRouter API Configuration (For production, proxy via Supabase Edge Function without VITE_ prefix)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key-here
VITE_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Supabase Configuration
# Supabase Dashboard -> Project Settings -> API -> Project URL / anon public key
# Then run supabase/schema.sql and supabase/seed.sql in the SQL Editor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

