{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    /* Strictness: declared explicitly so the CI "strict typecheck" step tells the
       truth and the setting cannot silently change. Measured with the pinned
       typescript 6.0.3: `tsc --strict -p tsconfig.app.json` introduces 0 errors
       beyond the current baseline (6.0 already defaults the strict family on). */
    "strict": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src"
  ]
}
